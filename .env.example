VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Public anon or publishable key belonging to the project above (never service_role).
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_KEY
# Legacy fallback: VITE_SUPABASE_PUBLISHABLE_KEY, used only if ANON_KEY is empty/unset.
# Keep disabled unless the separate reopen migration has been verified.
VITE_PLAN_REOPEN_ENABLED=false
